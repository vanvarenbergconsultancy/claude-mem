<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ClaudeMem.Admin.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeMem.Admin.Api.Contracts\ClaudeMem.Admin.Api.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeMem.Admin.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Database\schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="openapi\v1.yaml" Condition="Exists('openapi\v1.yaml')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyOpenApiSpec" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\openapi" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\docs\openapi.yaml"
          DestinationFiles="$(MSBuildProjectDirectory)\openapi\v1.yaml"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.SqlBuilder" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
