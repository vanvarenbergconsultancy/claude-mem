@page "/audit-log"
@using System.Text.Json
@inject IAuditLogClient AuditLogClient
@inject ITeamCacheService TeamCache
@inject IProjectCacheService ProjectCache
@inject ICacheInvalidationBus InvalidationBus
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Audit Log — ClaudeMem Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Audit Log</MudText>
    <MudSpacer />
</MudStack>

<MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4" Spacing="2">
    <MudItem>
        <MudAutocomplete T="Team"
                         Label="Team"
                         SearchFunc="SearchTeams"
                         Value="_selectedTeam"
                         ValueChanged="OnTeamSelected"
                         ToStringFunc="@(t => t?.Name ?? string.Empty)"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Clearable="true"
                         MinCharacters="0"
                         ResetValueOnEmptyText="true" />
    </MudItem>
    <MudItem>
        <MudAutocomplete T="Project"
                         Label="Project"
                         SearchFunc="SearchProjects"
                         Value="_selectedProject"
                         ValueChanged="OnProjectSelected"
                         ToStringFunc="@(p => p?.Name ?? string.Empty)"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Clearable="true"
                         MinCharacters="0"
                         Disabled="_selectedTeam is null"
                         ResetValueOnEmptyText="true" />
    </MudItem>
    <MudItem>
        <MudTextField @bind-Value="_actorId" Label="Actor ID" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem>
        <MudTextField @bind-Value="_apiKeyId" Label="API Key ID" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem>
        <MudTextField @bind-Value="_action" Label="Action" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem>
        <MudTextField @bind-Value="_resourceType" Label="Resource Type" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem>
        <MudDatePicker Date="_from" DateChanged="@((DateTime? d) => _from = d)" Label="From" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" />
    </MudItem>
    <MudItem>
        <MudDatePicker Date="_to" DateChanged="@((DateTime? d) => _to = d)" Label="To" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" />
    </MudItem>
    <MudItem Class="d-flex align-center gap-1">
        <MudButton Variant="Variant.Text" OnClick="Reload">Search</MudButton>
        <MudButton Variant="Variant.Text" OnClick="ClearFilters">Clear</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       aria-label="Refresh reference data"
                       OnClick="RefreshReferenceData" />
    </MudItem>
</MudStack>

<LoadStateView TData="AuditLogPage" IsLoading="_loading" Data="_page" ErrorMessage="Could not load audit log entries.">
    <ChildContent Context="page">
        <MudTable Items="page.Items" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                  OnRowClick="OnRowClick" T="AuditLogEntry" RowClass="cursor-pointer">
            <HeaderContent>
                <MudTh Style="min-width:160px">Created At</MudTh>
                <MudTh Style="min-width:140px">Team</MudTh>
                <MudTh Style="min-width:140px">Project</MudTh>
                <MudTh Style="min-width:140px">Actor</MudTh>
                <MudTh Style="min-width:140px">Action</MudTh>
                <MudTh Style="min-width:140px">Resource Type</MudTh>
                <MudTh Style="min-width:140px">Resource ID</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Created At">
                    <MudText Typo="Typo.body2">@context.CreatedAt?.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </MudTd>
                <MudTd DataLabel="Team">
                    <MudText Typo="Typo.body2">@(context.TeamName ?? context.TeamId ?? "—")</MudText>
                </MudTd>
                <MudTd DataLabel="Project">
                    <MudText Typo="Typo.body2">@(context.ProjectName ?? context.ProjectId ?? "—")</MudText>
                </MudTd>
                <MudTd DataLabel="Actor">
                    <MudText Typo="Typo.body2">@(context.ActorId ?? "—")</MudText>
                </MudTd>
                <MudTd DataLabel="Action">
                    <MudChip T="string" Size="Size.Small" Color="@ActionColor(context.Action)">@context.Action</MudChip>
                </MudTd>
                <MudTd DataLabel="Resource Type">
                    <MudText Typo="Typo.body2">@context.ResourceType</MudText>
                </MudTd>
                <MudTd DataLabel="Resource ID">
                    <MudText Typo="Typo.caption">@(context.ResourceId ?? "—")</MudText>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">No audit log entries match the current filter.</MudText>
            </NoRecordsContent>
        </MudTable>

        @if (page.Next is not null)
        {
            <MudButton Class="mt-2" OnClick="LoadMore" Variant="Variant.Text">Load more</MudButton>
        }
    </ChildContent>
</LoadStateView>

@if (_selectedEntry is not null)
{
    <MudPaper Elevation="0" Class="mt-4 pa-4" Style="border: 1px solid var(--mud-palette-lines-default)">
        <MudText Typo="Typo.h6" Class="mb-3">Entry Details</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">ID</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.Id ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Team</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.TeamName ?? _selectedEntry.TeamId ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Project</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.ProjectName ?? _selectedEntry.ProjectId ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Actor</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.ActorId ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">API Key ID</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.ApiKeyId ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Action</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.Action ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Resource Type</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.ResourceType ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Resource ID</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.ResourceId ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Created At</MudText>
                <MudText Typo="Typo.body2">@(_selectedEntry.CreatedAt?.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</MudText>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Details (JSON):</MudText>
        <pre style="overflow-x:auto;background:var(--mud-palette-background-grey);padding:12px;border-radius:4px;font-size:0.8rem">@GetFormattedDetails(_selectedEntry)</pre>
    </MudPaper>
}

@code {
    [CascadingParameter] private ProcessError? ProcessError { get; set; }

    private AuditLogPage? _page;
    private bool _loading = true;
    private AuditLogEntry? _selectedEntry;

    private IReadOnlyList<Team> _allTeams = Array.Empty<Team>();
    private Team? _selectedTeam;
    private Project? _selectedProject;
    private bool _disposed;

    private string _actorId = string.Empty;
    private string _apiKeyId = string.Empty;
    private string _action = string.Empty;
    private string _resourceType = string.Empty;
    private DateTime? _from;
    private DateTime? _to;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe before first load so an invalidation arriving during init
        // does not cause a missed refresh.
        InvalidationBus.Subscribe(HandleCacheInvalidated);
        _allTeams = await TeamCache.GetAll();
        await Reload();
    }

    public void Dispose()
    {
        _disposed = true;
        InvalidationBus.Unsubscribe(HandleCacheInvalidated);
    }

    private async Task HandleCacheInvalidated(string key)
    {
        if (_disposed)
        {
            return;
        }
        await InvokeAsync(async () =>
        {
            try
            {
                if (key == CacheKeys.TeamsAll)
                {
                    _allTeams = await TeamCache.GetAll();
                }
                StateHasChanged();
            }
#pragma warning disable CA1031
            catch (Exception)
#pragma warning restore CA1031
            {
                Snackbar.Add("Failed to refresh reference data.", Severity.Warning);
            }
        });
    }

    private Task<IEnumerable<Team>> SearchTeams(string value, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        IEnumerable<Team> results = string.IsNullOrEmpty(value)
            ? _allTeams
            : _allTeams.Where(t => t.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
        return Task.FromResult(results);
    }

    private async Task<IEnumerable<Project>> SearchProjects(string value, CancellationToken cancellationToken)
    {
        if (_selectedTeam?.Id is null)
        {
            return Enumerable.Empty<Project>();
        }
        var projects = await ProjectCache.GetForTeam(_selectedTeam.Id, cancellationToken);
        return string.IsNullOrEmpty(value)
            ? projects
            : projects.Where(p => p.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
    }

    private async Task OnTeamSelected(Team? team)
    {
        _selectedTeam = team;
        _selectedProject = null;
        await Reload();
    }

    private async Task OnProjectSelected(Project? project)
    {
        _selectedProject = project;
        await Reload();
    }

    private async Task RefreshReferenceData()
    {
        TeamCache.Invalidate(CancellationToken.None);
        ProjectCache.InvalidateAll(CancellationToken.None);
        _allTeams = await TeamCache.GetAll();
        _selectedTeam = null;
        _selectedProject = null;
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _selectedEntry = null;
        try
        {
            _page = await AuditLogClient.AuditLogAsync(
                teamId: _selectedTeam?.Id,
                projectId: _selectedProject?.Id,
                actorId: string.IsNullOrEmpty(_actorId) ? null : _actorId,
                apiKeyId: string.IsNullOrEmpty(_apiKeyId) ? null : _apiKeyId,
                action: string.IsNullOrEmpty(_action) ? null : _action,
                resourceType: string.IsNullOrEmpty(_resourceType) ? null : _resourceType,
                from: _from.HasValue ? (DateTimeOffset?)new DateTimeOffset(_from.Value, TimeSpan.Zero) : null,
                to: _to.HasValue ? (DateTimeOffset?)new DateTimeOffset(_to.Value, TimeSpan.Zero) : null
            );
        }
        catch (Exception ex)
        {
            _page = null;
            ProcessError?.HandleError(ex);
        }
        _loading = false;
    }

    private async Task LoadMore()
    {
        if (_page?.Next is null)
        {
            return;
        }

        try
        {
            var cursor = CursorHelper.ExtractCursor(_page.Next);
            var nextPage = await AuditLogClient.AuditLogAsync(
                cursor: cursor,
                teamId: _selectedTeam?.Id,
                projectId: _selectedProject?.Id,
                actorId: string.IsNullOrEmpty(_actorId) ? null : _actorId,
                apiKeyId: string.IsNullOrEmpty(_apiKeyId) ? null : _apiKeyId,
                action: string.IsNullOrEmpty(_action) ? null : _action,
                resourceType: string.IsNullOrEmpty(_resourceType) ? null : _resourceType,
                from: _from.HasValue ? (DateTimeOffset?)new DateTimeOffset(_from.Value, TimeSpan.Zero) : null,
                to: _to.HasValue ? (DateTimeOffset?)new DateTimeOffset(_to.Value, TimeSpan.Zero) : null
            );
            var allItems = (_page.Items as List<AuditLogEntry>) ?? new List<AuditLogEntry>(_page.Items);
            allItems.AddRange(nextPage.Items);
            _page = new AuditLogPage(nextPage.Self, _page.First, nextPage.Next, allItems);
        }
        catch (Exception ex)
        {
            ProcessError?.HandleError(ex);
        }
    }

    private void OnRowClick(TableRowClickEventArgs<AuditLogEntry> args)
    {
        if (_selectedEntry?.Id == args.Item?.Id)
        {
            _selectedEntry = null;
        }
        else
        {
            _selectedEntry = args.Item;
        }
    }

    private async Task ClearFilters()
    {
        _selectedTeam = null;
        _selectedProject = null;
        _actorId = string.Empty;
        _apiKeyId = string.Empty;
        _action = string.Empty;
        _resourceType = string.Empty;
        _from = null;
        _to = null;
        await Reload();
    }

    private static Color ActionColor(string? action)
    {
        if (action is null)
        {
            return Color.Default;
        }
        if (action.StartsWith("create", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Success;
        }
        if (action is "scope_violation" or "stalled" or "revoked_key")
        {
            return Color.Error;
        }
        if (action.StartsWith("revoke", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Warning;
        }
        return Color.Default;
    }

    private static string GetFormattedDetails(AuditLogEntry entry)
    {
        if (entry.Details is null || entry.Details.Count == 0)
        {
            return "—";
        }
        return JsonSerializer.Serialize(entry.Details, new JsonSerializerOptions { WriteIndented = true });
    }
}
