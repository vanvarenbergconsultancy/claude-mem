@inject IProjectsClient ProjectsClient

<CreateEntityDialog TResult="Project"
    DialogTitle="New Project"
    FieldLabel="Project name"
    OnSubmitAsync="OnCreateProjectButtonClicked" />

@code {
    [Parameter] public string TeamId { get; set; } = string.Empty;

    private async Task<Project> OnCreateProjectButtonClicked(string projectName)
    {
        return await ProjectsClient.ProjectsPostAsync(new Project(null, null, projectName, null, null, null), TeamId);
    }

}
